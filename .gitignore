node_modules/
dist/
coverage/
*.tsbuildinfo

# Git worktrees kept inside the checkout. Untracked they make every build look
# dirty, which suppresses the released.json update and blocks deploy.sh.
.worktrees/

.env
.env.*
!.env.example
*.local

data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

*.jks
*.keystore
*.p12
*.mobileprovision

.DS_Store
.idea/
.vscode/
DerivedData/
.build/
.gradle/
**/build/
local.properties

# Locally published internal APK. It may contain environment-specific configuration.
apps/web/public/downloads/*.apk
apps/web/public/downloads/*.zip

# Metadata recorded beside the APK by scripts/publish-android-internal.sh.
apps/web/public/downloads/*.release

# The macOS update manifest written beside the client by scripts/publish-macos.sh.
# Unlike the .release above, this one is meant to be served: it is public build
# output, not something the repository declares.
apps/web/public/downloads/*.json

# Locally published SDK Maven artifacts. Built on demand and shipped with the next
# website deployment; the repository keeps no binaries.
apps/web/public/maven/
