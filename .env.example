# Copy this file to .env and fill every value locally.
# Never commit real domains, ports, credentials, tokens, or machine paths.

APP_BASE_URL=
MISSIONGO_DEV_SERVER_URL=
# Canonical HTTP(S) origin used to build absolute social preview image URLs.
MISSIONGO_PUBLIC_ORIGIN=
HTTP_HOST=
HTTP_PORT=
DATABASE_PATH=
ATTACHMENTS_PATH=
# The account to create when the database has none. Read once, on that first
# start, and ignored afterwards -- accounts live in the database, and a password
# changed from the console must not be reset by a redeploy. ADMIN_ACCOUNT_ID also
# has to stay put: it is the id already recorded against this deployment's
# machines, dispatches, events and comments.
ADMIN_ACCOUNT_ID=
# Sign-in is by email address.
ADMIN_USERNAME=
ADMIN_PASSWORD_SCRYPT=
SESSION_SECRET=
# Which peers may set X-Forwarded-For. Leave empty to trust none (correct for a
# directly exposed or loopback-only server). Behind a reverse proxy, list the
# trusted proxy addresses, CIDR ranges, or named ranges such as
# "loopback,uniquelocal". Never use "true" on a public address: it lets any
# client forge its own IP and defeat the sign-in rate limit.
TRUST_PROXY=
# Deployment-level operator credential for scripts and backups. It carries no
# account, so it reaches every product regardless of permissions. Not a sign-in.
ADMIN_API_TOKEN=
# How much of the MCP write surface to expose: none (default), comments, or all.
# "none" is the read-only server. "comments" lets an authorized AI add comments and
# nothing else. "all" additionally opens claiming, leases and status transitions.
# A client still needs the missiongo:write scope, which the user grants at sign-in.
MISSIONGO_WRITE_TOOLS=
# Optional comma-separated product IDs for the initial account's AI read access.
# Leave empty to allow all products. Use real IDs only in the private environment
# file. Seeded into the account's permissions on that first start; edit it from
# the console afterwards, not here.
ADMIN_AUTHORIZED_PRODUCT_IDS=
