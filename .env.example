# Copy this file to .env and fill every value locally.
# Never commit real domains, ports, credentials, tokens, or machine paths.

APP_BASE_URL=
MISSIONGO_DEV_SERVER_URL=
# Canonical HTTP(S) origin used to build absolute social preview image URLs.
MISSIONGO_PUBLIC_ORIGIN=
HTTP_HOST=
HTTP_PORT=
DATABASE_PATH=
ATTACHMENTS_PATH=
ADMIN_ACCOUNT_ID=
ADMIN_USERNAME=
ADMIN_PASSWORD_SCRYPT=
SESSION_SECRET=
ADMIN_API_TOKEN=
# Optional comma-separated product IDs for the initial account's AI read access.
# Leave empty to allow all products. Use real IDs only in the private environment file.
ADMIN_AUTHORIZED_PRODUCT_IDS=
