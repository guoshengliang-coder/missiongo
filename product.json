{
  "name": "MissionGo",
  "icon": "apps/web/public/icon.svg",
  "versionNameSource": "sdks/android-feedback/gradle.properties#missiongoAndroidVersionName",
  "android": {
    "app": {
      "path": "apps/android",
      "applicationId": "io.missiongo.android",
      "label": "MissionGo"
    },
    "feedbackSample": {
      "path": "sdks/android-feedback/sample",
      "applicationId": "io.missiongo.feedback.sample",
      "label": "MissionGo SDK 验证"
    }
  },
  "macos": {
    "app": {
      "path": "apps/macos",
      "bundleIdentifier": "io.missiongo.macos",
      "label": "MissionGo"
    }
  },
  "linuxNode": {
    "path": "apps/node",
    "npmPackage": "@missiongo/node",
    "command": "missiongo-node",
    "version": "0.1.7"
  },
  "web": {
    "version": "1.1.20"
  },
  "iconSource": "assets/brand/icon.svg",
  "taglines": {
    "zh-CN": "一站式AI交付平台",
