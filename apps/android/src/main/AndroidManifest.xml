<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The attention notifications (AND-150). Requested from the activity on
         first launch; without it the push signals still refresh the widget. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only so the app can offer to clear the screenshots it just uploaded. It
         asks at the moment the offer is accepted, never on launch. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- AND-185: Huawei and HONOR launchers take the icon count through their own
         badge provider, which requires its permission. Unknown to every other
         ROM, where an undeclared-but-unused permission is simply ignored. -->
    <uses-permission android:name="com.hihonor.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />

    <application
        android:name="io.missiongo.android.MissionGoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.MissionGo">
        <!--
             androidx.work arrives through the feedback SDK, and its startup
             provider runs before Application.onCreate to bring up WorkManager and
             open its Room database, a cost paid on every cold start. The only
             user here is the home-screen widget's periodic refresh (AND-149), so
             MissionGoApplication implements Configuration.Provider and
             WorkManager initialises on demand, the first time the widget asks.

             This removal applies to this app's merged manifest alone; a host app
             that integrates the SDK keeps its own initializer and its queued
             submissions.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <activity
            android:name="io.missiongo.android.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="io.missiongo.android.widget.MissionGoWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/missiongo_widget_info" />
        </receiver>

        <!-- AND-150: the FCM signal arrives here, and the notification's
             「无需处理」button comes back to the receiver below. Both are driven
             by explicit intents from this app only. -->
        <service
            android:name="io.missiongo.android.push.MissionGoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name="io.missiongo.android.push.DismissReceiver"
            android:exported="false" />
    </application>
</manifest>
