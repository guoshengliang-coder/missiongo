.git
.gitignore
.DS_Store
.env
.env.*
!.env.example
# Local-only notes and handover documents. Ignored via .git/info/exclude,
# which rsync does not read, so name it here too.
.private
# Same reasoning, same trap: the compose build context is the whole release
# directory, and .claude/worktrees is ignored only in .git/info/exclude while
# .worktrees was ignored nowhere. Neither is copied into the image, but both
# were being handed to the daemon as build context.
.worktrees
.claude/worktrees
node_modules
**/node_modules
dist
**/dist
build
**/build
.gradle
**/.gradle
coverage
**/coverage
data
**/data
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.jks
*.keystore
*.p12
*.mobileprovision
local.properties

# Build metadata for the deploy script. It must never reach /downloads/.
apps/web/public/downloads/*.release
